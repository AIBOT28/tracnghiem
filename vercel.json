{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/nldk/Exam/:path*",
      "destination": "http://tracnghiemapi.runasp.net/api/Exam/:path*"
    },
    {
      "source": "/api/Auth/:path*",
      "destination": "http://tracnghiemapi.runasp.net/api/Auth/:path*"
    }
  ]
}
